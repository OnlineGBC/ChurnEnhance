# ------------------------------------------------------------------------------
# Python general
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
.cache
pytest_cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Virtual environments
env/
venv/
.venv/
venv.bak/
.env/

# OS generated files
.DS_Store
Thumbs.db

# ------------------------------------------------------------------------------
# Streamlit specific
# ------------------------------------------------------------------------------
# Streamlit stores secrets in .streamlit/secrets.toml (by default).
# Excluding secrets to avoid committing sensitive credentials to source control.
.streamlit/secrets.toml

# (Optional) If you have a local config, exclude it as well:
.streamlit/config.toml

certs/*
temp_uploaded_files/*

