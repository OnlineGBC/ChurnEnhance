# ProductFlag.py

"""
ProductFlag.py provides Streamlit UI functionality for analyzing customer sales inactivity (churn analysis).

Functions provided in this script:
- sorted_csv_by_inactivity: Sorts customer data based on the 'sales_inactivity' column in descending order,
  and converts it into CSV format.
- format_transactiondate: Ensures the 'transactiondate' column is in a consistent MM/DD/YYYY date format.
- show_sales_flag: Displays sales inactivity analysis in Streamlit, provides downloadable CSV files
  based on churn thresholds (Yellow and Red flags), and handles UI interactions and warnings.

External modules and scripts this file interacts with:
- streamlit: For creating and handling web-based user interfaces.
- pandas: For data manipulation, handling, and processing.
- SalesChurn.py (flag_churn function): For calculating churn segments based on inactivity days.
- file_cleansing.py: Calls this script to execute and display sales inactivity analyses.

This script itself is called directly by the main script 'file_cleansing.py' and does not call it back.
"""

# Import necessary libraries and modules
import streamlit as st
import pandas as pd
from SalesChurn import flag_churn
from typing import Any

# Function to sort a DataFrame by 'sales_inactivity' and convert it into CSV bytes
def sorted_csv_by_inactivity(df: pd.DataFrame) -> bytes:
    """
    Takes a DataFrame with a 'sales_inactivity' column,
    sorts it in descending order, and returns it as CSV in UTF-8 bytes format.
    """
    df_sorted = df.sort_values(by="sales_inactivity", ascending=False)
    return df_sorted.to_csv(index=False).encode("utf-8")

# Function to format the 'transactiondate' column to 'MM/DD/YYYY' string format
def format_transactiondate(df: pd.DataFrame) -> pd.DataFrame:
    """Format 'transactiondate' as MM/DD/YYYY."""
    df = df.copy()
    df["transactiondate"] = pd.to_datetime(
        df["transactiondate"], errors="coerce"
    ).dt.strftime("%m/%d/%Y")
    return df

# Main function to display the Sales Inactivity / Churn Flags section on the web page
def show_sales_flag(df_valid: pd.DataFrame, noop: Any):
    """
    Display the Sales Inactivity / Churn Flags section in the Streamlit UI.
    Performs customer churn analysis based on user-defined thresholds.
    """
    # Display custom styled header
    st.markdown(
        '<h2 class="sales-flag">🚩 Flagging by Sales Inactivity</h2>',
        unsafe_allow_html=True
    )

    # Check for required 'transactiondate' column and warn if absent
    if "transactiondate" not in df_valid.columns:
        st.warning(
            "The valid customers data does not contain a 'transactiondate' column. "
            "Please include it to calculate sales inactivity."
        )
        return

    # Check if churn thresholds have been set and applied
    if not st.session_state.get("apply", False):
        st.info("Set your Yellow & Red flags in the sidebar, then click 'Apply Thresholds'.")
        return

    # Drop any Excel-generated empty columns like "Unnamed:..."
    df_valid = df_valid.loc[:, ~df_valid.columns.str.startswith("Unnamed")]

    # Make a copy and convert 'transactiondate' to datetime
    df_valid = df_valid.copy()
    df_valid["transactiondate"] = pd.to_datetime(df_valid["transactiondate"], errors="coerce")
    today = pd.Timestamp.today()

    # Calculate sales inactivity as days since last transaction
    df_valid["sales_inactivity"] = (today - df_valid["transactiondate"]).dt.days

    # Segment data into churn groups (df_last, df_yellow, df_red)
    df_last, df_yellow, df_red = flag_churn(
        df_valid, today, st.session_state.yellow, st.session_state.red
    )

    # Format 'transactiondate' columns for readability
    df_yellow = format_transactiondate(df_yellow)
    df_red = format_transactiondate(df_red)

    # Yellow-flagged customers: inactive within a medium range (between Yellow and Red thresholds)
    st.markdown(
        f'<h3 style="color:#FAF3E0">🟨 Inactivity ≥ {st.session_state.yellow} and < {st.session_state.red} days</h3>',
        unsafe_allow_html=True
    )
    st.download_button(
        label="Download YellowFlagCustomers.csv",
        data=sorted_csv_by_inactivity(df_yellow),
        file_name="YellowFlagCustomers.csv",
        mime="text/csv",
        on_click=noop
    )

    # Red-flagged customers: highly inactive customers exceeding Red threshold
    st.markdown(
        f'<h3 style="color:#FAF3E0">🟥 Inactivity > {st.session_state.red} days</h3>',
        unsafe_allow_html=True
    )
    st.download_button(
        label="Download RedFlagCustomers.csv",
        data=sorted_csv_by_inactivity(df_red),
        file_name="RedFlagCustomers.csv",
        mime="text/csv",
        on_click=noop
    )

    # Final message indicating completion of file generation
    st.markdown(
        '<p style="color:#FAF3E0; font-size:1.2em;">Flagged customer files generated.</p>',
        unsafe_allow_html=True
    )
